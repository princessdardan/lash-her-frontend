{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-sanity-env.mjs",
    "build": "next build --webpack",
    "audit:ci": "npm audit --audit-level=moderate",
    "start": "next start",
    "lint": "eslint",
    "resend:seed-templates": "tsx --conditions=react-server scripts/seed-resend-templates.ts",
    "sanity:backfill-home-training": "node scripts/backfill-home-training-programs-block.mjs",
    "check:square-card-on-file-env": "node scripts/check-square-card-on-file-env.mjs",
    "test": "playwright test",
    "test:unit": "npm run test:unit:src && npm run test:unit:scripts",
    "test:unit:src": "node scripts/run-source-unit-tests.mjs --no-db",
    "test:unit:db": "node scripts/run-source-unit-tests.mjs --db-only",
    "test:unit:all": "npm run test:unit && npm run test:unit:db",
    "test:coverage:critical": "c8 --config scripts/critical-coverage.config.json npm run test:unit:all && node scripts/verify-critical-source-coverage.mjs",
    "test:unit:scripts": "node --test scripts/check-square-card-on-file-env.test.mjs",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:browser:verify": "node scripts/verify-playwright-coverage.mjs",
    "test:e2e:seed-commerce": "tsx --conditions=react-server scripts/seed-commerce-enabled-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-private-db.ts",
    "db:check": "tsx scripts/check-private-db-migrations.ts",
    "booking:bootstrap-legacy": "tsx --conditions=react-server scripts/bootstrap-booking-operations.ts",
    "booking:import-operational-cutover": "tsx --conditions=react-server scripts/import-booking-operational-cutover.ts",
    "db:create-payment-reconciliation-indexes": "tsx scripts/create-payment-reconciliation-indexes.ts",
    "stock:backfill": "tsx --conditions=react-server scripts/backfill-product-stock.ts",
    "marketing:backfill-sync": "tsx --conditions=react-server scripts/backfill-marketing-sync-jobs.ts",
    "marketing:inspect-sync": "tsx --conditions=react-server scripts/inspect-marketing-sync-failures.ts",
    "marketing:requeue-sync-failures": "tsx --conditions=react-server scripts/requeue-marketing-sync-failures.ts",
    "git:verify-remote": "node scripts/verify-git-remote.mjs origin",
    "git:push-staging": "npm run git:verify-remote && git push origin staging",
    "prepare": "husky"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "13.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@opentelemetry/winston-transport": "^0.31.0",
    "@portabletext/react": "^6.0.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/client": "^7.20.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/vercel-protection-bypass": "^3.1.0",
    "@upstash/redis": "^1.35.8",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^152.0.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "nanoid": "^3.3.11",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "^11.6.12",
    "pg": "^8.20.0",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.4",
    "sanitize-html": "^2.17.7",
    "sanity": "^4.22.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.1.18",
    "tailwind-merge": "^3.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.8",
    "c8": "^10.1.3",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.0"
    },
    "@sanity/uuid": "3.0.3",
    "dompurify": "3.4.13",
    "form-data": "4.0.6",
    "load-yaml-file": {
      "js-yaml": "3.15.1"
    },
    "markdown-it": "15.0.0",
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@5": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.26",
    "protobufjs": "7.6.5",
    "sharp": "0.35.0",
    "tar": "7.5.21",
    "undici": "6.28.0",
    "valibot": "1.4.2",
    "vite": "7.3.5"
  }
}
