      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "ok"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/internal/course/enrollment-events": {
      "post": {
        "description": "Durably receives one Course enrollment transition event.",
        "operationId": "receiveCourseEnrollmentEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "data": {
                    "additionalProperties": false,
                    "properties": {
                      "courseId": {
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "type": "string"
                      },
                      "effectiveAt": {
                        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
                        "type": "string"
                      },
                      "state": {
                        "anyOf": [
                          {
                            "enum": [
                              "active"
                            ],
                            "type": "string"
                          },
                          {
                            "enum": [
                              "revoked"
                            ],
                            "type": "string"
                          }
                        ]
                      },
                      "userId": {
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "userId",
                      "courseId",
                      "state",
                      "effectiveAt"
                    ],
                    "type": "object"
                  },
                  "eventId": {
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  "eventType": {
                    "anyOf": [
                      {
                        "enum": [
                          "enrollment.activated"
                        ],
                        "type": "string"
                      },
                      {
                        "enum": [
                          "enrollment.revoked"
                        ],
                        "type": "string"
                      }
                    ]
                  },
                  "occurredAt": {
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
                    "type": "string"
                  },
                  "producer": {
                    "enum": [
                      "lash-her-course-api"
                    ],
                    "type": "string"
                  },
                  "schemaVersion": {
                    "enum": [
                      1
                    ],
                    "type": "number"
                  },
                  "stream": {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "type": "string"
                      },
                      "version": {
                        "maximum": 2147483647,
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "id",
                      "version"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "eventId",
                  "eventType",
                  "schemaVersion",
                  "producer",
                  "occurredAt",
                  "stream",
                  "data"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "eventId": {
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "duplicate"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "eventId",
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          },
          "202": {
