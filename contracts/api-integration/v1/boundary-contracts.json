{
  "openapi": "3.1.0",
  "info": {
    "title": "Lash Her integration boundary contracts v1",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "CourseLearnerClaims": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "iss", "aud", "sub", "iat", "exp", "jti"],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "iss": {
            "type": "string",
            "const": "lash-her-frontend"
          },
          "aud": {
            "type": "string",
            "const": "lash-her-course-api:learner"
          },
          "sub": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "iat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "jti": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CommunityMemberClaims": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "iss", "aud", "sub", "iat", "exp", "jti"],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "iss": {
            "type": "string",
            "const": "lash-her-frontend"
          },
          "aud": {
            "type": "string",
            "const": "lash-her-community-api:member"
          },
          "sub": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "iat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "jti": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CourseAdminClaims": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "iss",
          "aud",
          "sub",
          "iat",
          "exp",
          "jti",
          "capabilities"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "iss": {
            "type": "string",
            "const": "lash-her-frontend"
          },
          "aud": {
            "type": "string",
            "const": "lash-her-course-api:admin"
          },
          "sub": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "iat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "jti": {
            "type": "string",
            "format": "uuid"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["course-editor", "course-support"]
            }
          }
        }
      },
      "CommunityAdminClaims": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "iss",
          "aud",
          "sub",
          "iat",
          "exp",
          "jti",
          "capabilities"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "iss": {
            "type": "string",
            "const": "lash-her-frontend"
          },
          "aud": {
            "type": "string",
            "const": "lash-her-community-api:admin"
          },
          "sub": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "iat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "jti": {
            "type": "string",
            "format": "uuid"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["community-moderator"]
            }
          }
        }
      },
      "AccountLifecycleCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "commandId",
          "userId",
          "accountVersion",
          "action",
          "issuedAt"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "commandId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "userId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "accountVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "action": {
            "type": "string",
            "enum": ["suspend", "restore", "export", "delete"]
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccountLifecycleReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "accountVersion", "status"],
        "properties": {
          "commandId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "accountVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": ["accepted", "duplicate"]
          }
        }
      },
      "CourseError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "CommunityError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "requestId"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
