2026-11-05T23:58:48.5455145Z [36;1m[0m
2026-11-05T23:58:48.5455714Z [36;1m  if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then[0m
2026-11-05T23:58:48.5456715Z [36;1m    # If action was provided with explicit input by the caller set that[0m
2026-11-05T23:58:48.5457698Z [36;1m    # Use printf %q to safely escape special characters and prevent command injection[0m
2026-11-05T23:58:48.5458666Z [36;1m    printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt[0m
2026-11-05T23:58:48.5459363Z [36;1m  fi[0m
2026-11-05T23:58:48.5459738Z [36;1m}[0m
2026-11-05T23:58:48.5460302Z [36;1m[0m
2026-11-05T23:58:48.5460864Z [36;1m# Set environment variables, handling those with default values[0m
2026-11-05T23:58:48.5461923Z [36;1m# cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables[0m
