# Owned compatibility fixture only. Sources and installed pure-JS PG/Drizzle
# dependencies are mounted read-only; no cloud credential or external URL input.
FROM node:24.18.0-trixie-slim@sha256:ae91dcc111a68c9d2d81ff2a17bda61be126426176fde6fe7d08ab13b7f50573 AS node
FROM postgres:18@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
ENV FRONTEND_MIGRATION_LOCAL_TEST=true
ENV FRONTEND_MIGRATION_POSTGRES18_LOCAL_TEST=true
ENV PG_BIN=/usr/lib/postgresql/18/bin
WORKDIR /source
USER postgres
ENTRYPOINT []
CMD ["node", "ops/platform/test-frontend-migration-local.mjs"]
