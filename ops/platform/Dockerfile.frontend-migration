FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS build
WORKDIR /app
COPY ops/platform/frontend-migration-deps/package.json ops/platform/frontend-migration-deps/package-lock.json ./
RUN npm ci --omit=dev --omit=optional --ignore-scripts && npm cache clean --force
COPY ops/platform/frontend-migration.mjs ops/platform/frontend-schema.mjs ops/platform/frontend-image.mjs ops/platform/frontend-image-source.mjs ops/platform/source-checkout.mjs ops/platform/release-inputs.mjs ops/platform/source-policy.mjs ops/platform/release.mjs ./ops/platform/
COPY ops/platform/qualification-target-profile.mjs ops/platform/qualification-target-profiles.json ./ops/platform/
COPY ops/platform/p2-profiled-current-probe.mjs ops/platform/p2-recovery-current-probe.mjs ./ops/platform/
COPY src/lib/private-db/migration-lineage.ts ./src/lib/private-db/
COPY scripts/api-contract-tools.mjs scripts/api-contract-compatibility-review.mjs ./scripts/
COPY contracts/api-integration/v1/manifest.json ./contracts/api-integration/v1/
COPY contracts/api-integration/p2-candidate/ ./contracts/api-integration/p2-candidate/
COPY drizzle/*.sql ./drizzle/
COPY drizzle/meta/_journal.json ./drizzle/meta/
ARG FRONTEND_SOURCE_COMMIT
RUN node ops/platform/frontend-image-source.mjs --write "$FRONTEND_SOURCE_COMMIT"
RUN node ops/platform/frontend-image.mjs --manifest-only

FROM buildpack-deps:trixie@sha256:059b2051d977584f515d03f39881bbf3c53cad9a0d1938c69d1b108ccddda48b AS zlib-build
COPY ops/gateway/runtime/ /runtime/
RUN ulimit -c 0; sh /runtime/build.sh

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:a6c34457f6da4295807e051411c7783739c65b997a324fed14e4fa292615ae91
WORKDIR /app
COPY --from=zlib-build /out/rootfs/ /
ENV NODE_ENV=production
ENV PATH=/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=build /app /app
USER nonroot:nonroot
ENTRYPOINT []
CMD ["node", "ops/platform/frontend-image.mjs", "--manifest-only"]
