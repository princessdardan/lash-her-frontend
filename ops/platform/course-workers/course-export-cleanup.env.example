# Non-deployable staging example. Substitute the reviewed runtime-role URL in
# the protected release directory; never commit the rendered file.
NODE_ENV=production
DATABASE_TARGET=staging
STAGING_DATABASE_URL=postgresql://course_runtime:REPLACE_PRIVATE_VALUE@database.invalid/course?sslmode=verify-full
COURSE_ACCOUNT_EXPORT_CLEANUP_ENABLED=false
COURSE_ACCOUNT_EXPORT_CLEANUP_POLL_MS=60000
# This process needs no Mux, learner/admin, signing or service credentials.
