# Non-deployable staging example. Substitute the reviewed runtime-role URL in
# the protected release directory; never commit the rendered file.
NODE_ENV=production
DATABASE_TARGET=staging
STAGING_DATABASE_URL=postgresql://course_runtime:REPLACE_PRIVATE_VALUE@database.invalid/course?sslmode=verify-full
MUX_MEDIA_RECOVERY_ENABLED=false
MUX_MEDIA_CLEANUP_ENABLED=false
MUX_MEDIA_RECOVERY_POLL_INTERVAL_MS=60000
# Only when enabling reviewed staging recovery, add MUX_TOKEN_ID,
# MUX_TOKEN_SECRET and MUX_ENVIRONMENT_ID for that exact Mux environment.
# Cleanup remains separately false until ownership/replacement checks qualify.
