{
  "git": {
    "deploymentEnabled": false
  },
  "schedules": {
    "private-data-retention": {
      "path": "/api/admin/private-data-retention",
      "schedule": "17 8 * * *",
      "requestMethod": "GET"
    },
    "backup-validation": {
      "path": "/api/cron/backup-validation",
      "schedule": "0 6 * * 1",
      "requestMethod": "GET"
    },
    "payment-reconciliation": {
      "path": "/api/admin/payment-reconciliation",
      "schedule": "*/30 * * * *",
      "requestMethod": "GET"
    },
    "chitchats-shipping": {
      "path": "/api/cron/chitchats-shipping",
      "schedule": "* * * * *",
      "requestMethod": "GET"
    },
    "customer-email-outbox": {
      "path": "/api/cron/customer-email-outbox",
      "schedule": "*/5 * * * *",
      "requestMethod": "GET"
    },
    "product-stock-reservations": {
      "path": "/api/cron/product-stock-reservations",
      "schedule": "*/15 * * * *",
      "requestMethod": "GET"
    },
    "marketing-contact-sync": {
      "path": "/api/admin/marketing-contact-sync",
      "schedule": "*/5 * * * *",
      "requestMethod": "GET"
    },
    "shipping-rate-cache-refresh": {
      "path": "/api/cron/shipping-rate-cache-refresh",
      "schedule": "30 7 * * 1",
      "requestMethod": "GET"
    },
    "highlevel-sync": {
      "path": "/api/cron/highlevel-sync",
      "schedule": "* * * * *",
      "requestMethod": "GET"
    }
  }
}
